# Code Review Assistant Configuration

# Application
APP_NAME=Code Review Assistant
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8765

# Database (SQLite default, set PostgreSQL URL for Docker)
# DATABASE_URL=sqlite+aiosqlite:///./data/reviews.db
# DATABASE_URL=postgresql+asyncpg://codereview:secret@localhost:5432/codereview

# GitHub Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# AI Provider: openai | claude | off
AI_PROVIDER=off
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
CLAUDE_API_KEY=sk-ant-your-claude-key
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Default analysis categories (comma-separated)
DEFAULT_CATEGORIES=bugs,security,style,performance,architecture

# Max file size for analysis (KB)
MAX_FILE_SIZE_KB=500

# Auto-watch poll interval (seconds)
POLL_INTERVAL_SECONDS=300

# Encryption key for stored secrets (auto-generated if empty)
ENCRYPTION_KEY=
